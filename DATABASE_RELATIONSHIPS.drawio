        <!-- TABLE 1: RESTAURANTS -->
        <mxCell id="t_restaurants" value="&lt;b&gt;🏪 restaurants&lt;/b&gt;&lt;hr/&gt;🔑 &lt;b&gt;id&lt;/b&gt;: INT (PK)&lt;br/&gt;• name: VARCHAR(150)&lt;br/&gt;• slug: VARCHAR(150) UNIQUE&lt;br/&gt;• address, lat, lng, phone&lt;br/&gt;• is_active: TINYINT(1)" style="shape=swimlane;startSize=30;horizontal=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="240" height="180" as="geometry" />
        </mxCell>

        <!-- TABLE 2: USERS -->
        <mxCell id="t_users" value="&lt;b&gt;👤 users&lt;/b&gt;&lt;hr/&gt;🔑 &lt;b&gt;id&lt;/b&gt;: INT (PK)&lt;br/&gt;• name, phone (UNIQUE), email&lt;br/&gt;• role: ENUM('admin','delivery','customer')&lt;br/&gt;🔗 &lt;b&gt;restaurant_id&lt;/b&gt;: INT (FK)&lt;br/&gt;• status, customer_tag, preferred_channel" style="shape=swimlane;startSize=30;horizontal=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;rounded=1;shadow=1;" vertex="1" parent="1">
