        <!-- TABLE 1: RESTAURANTS -->
        <mxCell id="t_restaurants" value="&lt;div style=&quot;color:#0F172A;&quot;&gt;&lt;b style=&quot;color:#1E3A8A; font-size:14px;&quot;&gt;🏪 restaurants&lt;/b&gt;&lt;hr style=&quot;border-color:#3B82F6;&quot;/&gt;🔑 &lt;b style=&quot;color:#1E40AF;&quot;&gt;id&lt;/b&gt;: INT (PK)&lt;br/&gt;• name: VARCHAR(150)&lt;br/&gt;• slug: VARCHAR(150) UNIQUE&lt;br/&gt;• address, lat, lng, phone&lt;br/&gt;• is_active: TINYINT(1)&lt;/div&gt;" style="shape=swimlane;startSize=32;horizontal=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;fontColor=#0F172A;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="250" height="190" as="geometry" />
        </mxCell>

        <!-- TABLE 2: USERS -->
