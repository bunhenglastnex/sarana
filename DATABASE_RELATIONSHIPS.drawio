        <mxCell id="title" value="&lt;b&gt;ONLINE ORDERING SYSTEM - DATABASE ENTITY RELATIONSHIP DIAGRAM (ERD)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#1A2530;" vertex="1" parent="1">
